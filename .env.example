# Database
DATABASE_URL=postgresql+psycopg://hermes:hermes@localhost:5432/hermes_kv

# Object storage
OBJECT_STORE_TYPE=local
OBJECT_STORE_PATH=./data/object-store

# AI provider configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=deterministic-hash-v1
EMBEDDING_DIMENSIONS=8
TRANSCRIPTION_PROVIDER=local
OCR_PROVIDER=local

# Local single-user defaults
DEFAULT_TENANT_ID=local
DEFAULT_USER_ID=owner

# Optional providers / limits
# OPENAI_API_KEY=
# LOCAL_EMBEDDING_MODEL_PATH=
# WHISPER_MODEL=
MAX_UPLOAD_SIZE_MB=50
ALLOW_TEMP_AUDIO_DOWNLOAD=true
STORE_EXTERNAL_MEDIA_BY_DEFAULT=false
