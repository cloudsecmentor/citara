# HOW THIS FILE IS USED
# Copy to `.env` and it is loaded automatically -- by `docker compose`, and (since the
# hybrid-search work) by Citara's Python code at import time.
#
# Real environment variables always win: `.env` only fills in what is not already set,
# so an explicit `export` or a docker-compose `environment:` entry still takes
# precedence. Set `CITARA_SKIP_DOTENV=1` to ignore the file entirely.
#
# Configuration binds when `citara.core.config` is first imported, so anything you set
# programmatically must be set BEFORE importing citara.

# Corpus location
# Your corpus (database, artifacts, import state) lives OUTSIDE this code repo so
# transcripts, audio, and DB files can never be committed by accident. The default is
# a sibling `citara-data/` directory next to your checkout. `CITARA_DATA_ROOT` sets all
# four paths below at once; set it to any local, mounted, or synced directory.
# CITARA_DATA_ROOT=../citara-data

# Database
# Local SQLite default keeps runtime state outside this automation/code repo.
DATABASE_URL=sqlite:///../citara-data/citara.db
# For Docker/Postgres development, use:
# DATABASE_URL=postgresql+psycopg://citara:citara@localhost:5432/citara

# Object storage
OBJECT_STORE_TYPE=local
OBJECT_STORE_PATH=../citara-data/object-store

# Durable source artifacts
# Keep real transcripts/import artifacts outside the Git repo for personal corpora.
# Defaults intentionally point to a sibling directory outside the repo so real
# corpora are not accidentally committed. Override with any local, mounted, or
# synced directory in your private .env.
SOURCE_ARTIFACT_ROOT=../citara-data/source-artifacts
SOURCE_STATE_ROOT=../citara-data/import-state

# AI provider configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=deterministic-hash-v1
EMBEDDING_DIMENSIONS=8

# OpenAI embeddings
OPENAI_API_KEY=

# Azure AI Foundry / Azure OpenAI-compatible embeddings
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-01

# Server-side query-translation fallback (used only when a client calls
# search_knowledge/retrieve_context_pack without its own query_translated).
# Default is a no-op: no network calls, safe for offline/local/test use.
TRANSLATION_PROVIDER=noop
TRANSLATION_MODEL=gpt-4o-mini
# Reuses OPENAI_API_KEY / AZURE_OPENAI_* above when TRANSLATION_PROVIDER is
# openai / azure_foundry. AZURE_OPENAI_TRANSLATION_DEPLOYMENT overrides
# AZURE_OPENAI_DEPLOYMENT for translation specifically (embeddings and chat
# completions are usually different deployments).
# AZURE_OPENAI_TRANSLATION_DEPLOYMENT=

TRANSCRIPTION_PROVIDER=local
OCR_PROVIDER=local

# Remote transcription worker (only for scripts/transcribe_*_remote_batch.py).
# Deployment-specific, so there is no default: set it here or pass --worker.
# CITARA_WORKER_SSH=user@your-worker-host
# CITARA_WORKER_SSH_KEY=~/.ssh/id_ed25519
# CITARA_WORKER_ROOT=/opt/citara-worker

# Local single-user defaults
DEFAULT_TENANT_ID=local
DEFAULT_USER_ID=owner

# Optional providers / limits
# OPENAI_API_KEY=
# LOCAL_EMBEDDING_MODEL_PATH=
# WHISPER_MODEL=
MAX_UPLOAD_SIZE_MB=50
ALLOW_TEMP_AUDIO_DOWNLOAD=true
STORE_EXTERNAL_MEDIA_BY_DEFAULT=false
