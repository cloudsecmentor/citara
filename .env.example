# Database
# Local SQLite default keeps runtime state outside this automation/code repo.
DATABASE_URL=sqlite:///../citara/citara.db
# For Docker/Postgres development, use:
# DATABASE_URL=postgresql+psycopg://citara:citara@localhost:5432/citara

# Object storage
OBJECT_STORE_TYPE=local
OBJECT_STORE_PATH=../citara/object-store

# Durable source artifacts
# Keep real transcripts/import artifacts outside the Git repo for personal corpora.
# Defaults intentionally point to a sibling directory outside the repo so real
# corpora are not accidentally committed. Override with any local, mounted, or
# synced directory in your private .env.
SOURCE_ARTIFACT_ROOT=../citara/source-artifacts
SOURCE_STATE_ROOT=../citara/import-state

# AI provider configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=deterministic-hash-v1
EMBEDDING_DIMENSIONS=8

# OpenAI embeddings
OPENAI_API_KEY=

# Azure AI Foundry / Azure OpenAI-compatible embeddings
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-01

# Server-side query-translation fallback (used only when a client calls
# search_knowledge/retrieve_context_pack without its own query_translated).
# Default is a no-op: no network calls, safe for offline/local/test use.
TRANSLATION_PROVIDER=noop
TRANSLATION_MODEL=gpt-4o-mini
# Reuses OPENAI_API_KEY / AZURE_OPENAI_* above when TRANSLATION_PROVIDER is
# openai / azure_foundry. AZURE_OPENAI_TRANSLATION_DEPLOYMENT overrides
# AZURE_OPENAI_DEPLOYMENT for translation specifically (embeddings and chat
# completions are usually different deployments).
# AZURE_OPENAI_TRANSLATION_DEPLOYMENT=

TRANSCRIPTION_PROVIDER=local
OCR_PROVIDER=local

# Local single-user defaults
DEFAULT_TENANT_ID=local
DEFAULT_USER_ID=owner

# Optional providers / limits
# OPENAI_API_KEY=
# LOCAL_EMBEDDING_MODEL_PATH=
# WHISPER_MODEL=
MAX_UPLOAD_SIZE_MB=50
ALLOW_TEMP_AUDIO_DOWNLOAD=true
STORE_EXTERNAL_MEDIA_BY_DEFAULT=false
